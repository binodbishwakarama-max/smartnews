# General
PROJECT_NAME="Smart News Aggregator"
DEBUG=False

# Database
# Use postgresql://user:password@host:port/db for production
DATABASE_URL=sqlite:///./news.db

# Security
# CRITICAL: Change this in production! Run `openssl rand -hex 32` to generate one.
SECRET_KEY=CHANGE_THIS_SECRET_KEY_IMMEDIATELY_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS
# Comma separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-production-domain.com

# Scraper Settings
SCRAPER_INTERVAL_MIN=30
MAX_RETRIES=3

# Rate Limiting
# Rate limit for general endpoints (requests/minute)
GLOBAL_RATE_LIMIT=100/minute
# Rate limit for search endpoints (requests/minute)
SEARCH_RATE_LIMIT=20/minute

# External APIs (Optional)
# OPENAI_API_KEY=sk-...
